#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")"

usage() {
    echo "Usage: ./dev <tool> [args...]"
    echo ""
    echo "Recommended:"
    echo "  autarch tui              - Unified TUI with all tools (onboarding flow)"
    echo "  autarch tui --skip-onboard  - Go directly to dashboard"
    echo "  autarch tui --tool=X     - Jump to specific tab (bigend|signals|gurgeh|coldwine|pollard)"
    echo "  autarch tui --inline     - Inline mode (preserves terminal scrollback)"
    echo ""
    echo "Standalone CLI (for scripting, no TUI):"
    echo "  gurgeh     - Spec management CLI (list, create, export, etc.)"
    echo "  coldwine   - Task management CLI (init, status, etc.)"
    echo "  bigend     - Web server for mission control"
    echo "  pollard    - Research intelligence CLI"
    echo ""
    echo "Legacy aliases:"
    echo "  vauxhall -> bigend, praude -> gurgeh, tandemonium -> coldwine"
    echo ""
    echo "Examples:"
    echo "  ./dev autarch tui                 # Unified TUI (recommended)"
    echo "  ./dev autarch tui --tool=gurgeh   # Jump to Gurgeh tab"
    echo "  ./dev gurgeh list                 # List specs (CLI)"
    echo "  ./dev gurgeh export PRD-001       # Export spec to briefs"
    echo "  ./dev pollard scan                # Run research agents"
    echo "  ./dev bigend                      # Start web server"
    exit 1
}

if [ $# -lt 1 ]; then
    usage
fi

TOOL="$1"
shift

case "$TOOL" in
    autarch)
        go build -o autarch ./cmd/autarch
        exec ./autarch "$@"
        ;;
    bigend|vauxhall)
        go build -o bigend ./cmd/bigend
        exec ./bigend "$@"
        ;;
    pollard)
        go build -o pollard ./cmd/pollard
        exec ./pollard "$@"
        ;;
    gurgeh|praude)
        go build -o gurgeh ./cmd/gurgeh
        exec ./gurgeh "$@"
        ;;
    coldwine|tandemonium)
        go build -o coldwine ./cmd/coldwine
        exec ./coldwine "$@"
        ;;
    *)
        echo "Unknown tool: $TOOL"
        usage
        ;;
esac
