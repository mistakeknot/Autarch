   "body": "{\"schema\":\"home-move/v1\",\"kind\":\"pr\",\"pr\":{\"url\":\"https://github.com/a/b/pull/1\",\"why\":\"whim\"}}",
   "error": "pr why must be one of design, taste, spend",
   "kind": null
