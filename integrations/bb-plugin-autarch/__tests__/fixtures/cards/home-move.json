   "body": "{\"schema\":\"home-move/v1\",\"kind\":\"pr\",\"pr\":{\"url\":\"https://github.com/a/b/pull/1\",\"verdict\":\"great\"}}",
   "error": "pr verdict must be one of PASS, PASS-WITH-NOTES, HOLD, FAIL",
