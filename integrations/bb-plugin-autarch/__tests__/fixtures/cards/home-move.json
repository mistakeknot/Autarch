  {
   "name": "read with port",
   "body": "{\"schema\":\"home-move/v1\",\"kind\":\"read\",\"read\":{\"url\":\"https://github.com:444/x\"}}",
   "error": "read url must be https on an allowed host",
   "kind": null
  },
  {
   "name": "relative script path",
   "body": "{\"schema\":\"home-move/v1\",\"kind\":\"script\",\"script\":{\"path\":\"run.sh\",\"sha256\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"}}",
   "error": "script path must be an absolute path of letters, digits and ._/+- with no .. segment",
   "kind": null
  },
  {
   "name": "dotdot script path",
   "body": "{\"schema\":\"home-move/v1\",\"kind\":\"script\",\"script\":{\"path\":\"/a/../b\",\"sha256\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"}}",
   "error": "script path must be an absolute path of letters, digits and ._/+- with no .. segment",
   "kind": null
  },
  {
   "name": "short sha",
   "body": "{\"schema\":\"home-move/v1\",\"kind\":\"script\",\"script\":{\"path\":\"/a/b\",\"sha256\":\"abc\"}}",
   "error": "script sha256 must be 64 lowercase hex characters",
   "kind": null
  },
  {
   "name": "shell metacharacter arg",
   "body": "{\"schema\":\"home-move/v1\",\"kind\":\"script\",\"script\":{\"path\":\"/a/b\",\"sha256\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"args\":[\"$(id)\"]}}",
   "error": "each arg must match ^[A-Za-z0-9._/:=+@-]{1,200}$",
   "kind": null
  },
  {
   "name": "too many args",
   "body": "{\"schema\":\"home-move/v1\",\"kind\":\"script\",\"script\":{\"path\":\"/a/b\",\"sha256\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"args\":[\"a\",\"a\",\"a\",\"a\",\"a\",\"a\",\"a\",\"a\",\"a\"]}}",
   "error": "args must be an array of at most 8 strings",
   "kind": null
  },
  {
   "name": "recover with args",
   "body": "{\"schema\":\"home-move/v1\",\"kind\":\"script\",\"script\":{\"path\":\"/a/b\",\"sha256\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"recover\":{\"path\":\"/a/c\",\"sha256\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"args\":[\"x\"]}}}",
   "error": "recover takes only path and sha256",
   "kind": null
  },
  {
   "name": "empty need",
   "body": "{\"schema\":\"home-move/v1\",\"kind\":\"context\",\"context\":{\"need\":\"   \"}}",
   "error": "context need must be 1-2000 characters of text",
   "kind": null
