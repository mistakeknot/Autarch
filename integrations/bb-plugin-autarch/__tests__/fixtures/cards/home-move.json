   "body": "{\"schema\":\"home-move/v1\",\"kind\":\"pr\",\"pr\":{\"url\":\"https://github.com/a/b/pull/1\",\"summary\":\"a\\u2028b\"}}",
   "error": "pr summary must be one line of 1-200 characters",
   "kind": null
