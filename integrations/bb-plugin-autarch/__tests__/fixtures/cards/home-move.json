{
 "kind": "move",
 "env": {"HOME_MOVE_READ_HOSTS": "docs.example.test"},
 "cases": [
  {
   "name": "script with args and recover",
   "body": "{\"schema\":\"home-move/v1\",\"kind\":\"script\",\"script\":{\"path\":\"/srv/x/run.sh\",\"sha256\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"args\":[\"--check\",\"--dir=/tmp/x\"],\"recover\":{\"path\":\"/srv/x/undo.sh\",\"sha256\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"}}}",
   "error": null,
   "kind": "script"
  },
  {
   "name": "pr",
   "body": "{\"schema\":\"home-move/v1\",\"kind\":\"pr\",\"pr\":{\"url\":\"https://github.com/o/r/pull/12\"}}",
   "error": null,
   "kind": "pr"
  },
  {
   "name": "read github",
   "body": "{\"schema\":\"home-move/v1\",\"kind\":\"read\",\"read\":{\"url\":\"https://github.com/o/r/issues/3\"}}",
   "error": null,
   "kind": "read"
  },
  {
   "name": "read on a configured extra host",
   "body": "{\"schema\":\"home-move/v1\",\"kind\":\"read\",\"read\":{\"url\":\"https://docs.example.test/docs/plan\"}}",
   "error": null,
   "kind": "read"
  },
  {
   "name": "read on an unlisted host",
   "body": "{\"schema\":\"home-move/v1\",\"kind\":\"read\",\"read\":{\"url\":\"https://other.example.test/docs/plan\"}}",
   "error": "read url must be https on an allowed host",
   "kind": null
  },
  {
   "name": "context",
   "body": "{\"schema\":\"home-move/v1\",\"kind\":\"context\",\"context\":{\"need\":\"the staging token owner\"}}",
   "error": null,
   "kind": "context"
  },
  {
   "name": "not an object",
   "body": "[1]",
   "error": "home-move must be a JSON object",
   "kind": null
  },
  {
   "name": "wrong schema",
   "body": "{\"schema\":\"home-move/v2\",\"kind\":\"pr\",\"pr\":{\"url\":\"https://github.com/o/r/pull/1\"}}",
   "error": "schema must be home-move/v1",
   "kind": null
  },
  {
   "name": "unknown kind",
   "body": "{\"schema\":\"home-move/v1\",\"kind\":\"exec\",\"exec\":{}}",
   "error": "kind must be script, pr, read or context",
   "kind": null
  },
  {
   "name": "extra top-level field",
   "body": "{\"schema\":\"home-move/v1\",\"kind\":\"pr\",\"pr\":{\"url\":\"https://github.com/o/r/pull/1\"},\"run\":\"x\"}",
   "error": "unknown field \"run\" in home-move/v1",
   "kind": null
  },
  {
   "name": "missing member",
   "body": "{\"schema\":\"home-move/v1\",\"kind\":\"pr\"}",
   "error": "pr move needs a \"pr\" member",
   "kind": null
  },
  {
   "name": "pr off github",
   "body": "{\"schema\":\"home-move/v1\",\"kind\":\"pr\",\"pr\":{\"url\":\"https://example.com/o/r/pull/1\"}}",
   "error": "pr url must be https://github.com/<owner>/<repo>/pull/<n>",
   "kind": null
  },
  {
